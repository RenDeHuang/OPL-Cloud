{
  "schemaVersion": 1,
  "owner": "services/control-plane",
  "purpose": "Own the Workspace launch business operation, persisted stage decision, and recovery authorization without owning provider resources, spendable balance, or evidence receipts.",
  "state": "current",
  "machineBoundary": "Control Plane Workspace launch and recovery identity that is consumed by the current launch worker and the typed Fabric client.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Remove only when Workspace launch and recovery no longer cross the Control Plane to Fabric boundary."
  },
  "launchOperation": {
    "action": "workspace.launch.v2",
    "resultSchemaVersion": 2,
    "identityFields": [
      "launchOperationId",
      "accountId",
      "ownerUserId",
      "workspaceId",
      "requestHash"
    ],
    "requestHashAuthority": "services/control-plane",
    "workspaceIdentity": "stable_from_account_id_and_launch_operation_idempotency_identity",
    "sameIdempotencyRequest": "resume_original_launch",
    "idempotencyDrift": "conflict_before_new_launch_or_workspace"
  },
  "stageDecision": {
    "owner": "services/control-plane",
    "preflightAdmission": {
      "timing": "before_first_external_write",
      "mode": "read_only",
      "durableStage": false
    },
    "orderedStages": [
      "key",
      "debit",
      "ensure_compute_allocation",
      "ensure_storage",
      "ensure_attachment",
      "ensure_gateway_secret",
      "ensure_runtime",
      "activation",
      "receipt",
      "succeeded"
    ],
    "persistence": "phase_status_and_currentDecision_same_launch_postgresql_cas",
    "mutationAuthorization": "persisted_currentDecision_only",
    "fabricOperationBinding": "opl-cloud-fabric-launch-binding-contract.json"
  },
  "recovery": {
    "authority": "services/control-plane",
    "operation": "continue_original_workspace_launch",
    "routes": {
      "diagnose": "POST /api/operator/workspace-launches/{operationId}/recovery-plan/diagnose",
      "read": "GET /api/operator/workspace-launches/{operationId}/recovery-plan",
      "validate": "POST /api/operator/workspace-launches/{operationId}/recovery-plan/validate",
      "execute": "POST /api/operator/workspace-launches/{operationId}/recovery-plan/execute"
    },
    "operatorInputFields": [
      "accountId",
      "launchOperationId",
      "decision"
    ],
    "executeRequestFields": [
      "planId",
      "planDigest",
      "decision",
      "confirmation"
    ],
    "resourceIdentityInput": "forbidden_server_authoritative_readback_only",
    "unknownProviderResult": "remain_manual_review",
    "secondLaunch": "forbidden"
  },
  "notOwned": [
    "spendable_balance",
    "fabric_operation_store",
    "provider_resource_facts",
    "ledger_receipt_or_evidence_truth"
  ]
}
