{
  "schemaVersion": 16,
  "owner": "OPL Ledger",
  "purpose": "General execution, monthly billing, reconciliation, and current control-plane lifecycle evidence receipts.",
  "state": "current",
  "machineBoundary": "Receipt states, identity, opaque provenance, idempotency, reconciliation, and current receipt API shape.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Replace only with a newer current contract for the same boundary."
  },
  "currentScope": "Operator-provisioned Pilot Workspace receipts, reconciliation evidence, and non-customer general execution evidence; retired resource receipts remain historical read-only compatibility.",
  "receiptTypes": [
    "workspace.created",
    "workspace.compute_stopped",
    "workspace.compute_destroyed",
    "workspace.storage_destroyed",
    "workspace.access_token_reset",
    "workspace.access_token_deleted",
    "billing.reconciliation.v1",
    "billing.workspace_purchased.v1",
    "billing.workspace_renewed.v1",
    "billing.workspace_expired.v1",
    "billing.workspace_refunded.v1",
    "workspace.deleted.v1",
    "gateway.wallet_adjustment.v1",
    "workspace.gateway_key_rotated.v1",
    "execution.receipt.v1"
  ],
  "historicalReadOnlyReceiptCompatibility": {
    "types": [
      "workspace.compute_restarted",
      "workspace.compute_recreated",
      "billing.resource_purchased.v1",
      "billing.resource_renewed.v1",
      "billing.resource_expired.v1",
      "billing.resource_refunded.v1",
      "billing.charge_review_required.v1",
      "artifact.manifest.v1",
      "review.result.v1"
    ],
    "existingReceiptsReadable": true,
    "newWritesAllowed": false
  },
  "requiredFields": [
    "type",
    "status",
    "surface",
    "workspaceId",
    "Idempotency-Key header"
  ],
  "readiness": {
    "endpoint": "GET /readyz",
    "publicProbe": true,
    "backingStoreCheck": "PostgreSQL PingContext",
    "readyStatus": 200,
    "unavailableStatus": 503
  },
  "generalReceiptV1": {
    "pilotStatus": "not_exposed_in_operator_provisioned_pilot",
    "api": {
      "record": "POST /ledger/receipts",
      "list": "GET /ledger/receipts",
      "query": "GET /ledger/receipts/<receiptId>"
    },
    "query": {
      "endpoint": "GET /ledger/receipts",
      "exactFilters": [
        "organizationId",
        "workspaceId",
        "projectId",
        "taskId",
        "jobId",
        "type",
        "status"
      ],
      "prefixFilters": ["typePrefix"],
      "mutuallyExclusiveFilters": [["type", "typePrefix"]],
      "order": [
        "createdAt desc",
        "receiptId desc"
      ],
      "pagination": {
        "cursor": "opaque_createdAt_receiptId",
        "defaultLimit": 50,
        "maxLimit": 100,
        "filtersAppliedBeforePagination": true
      }
    },
    "statuses": [
      "planned",
      "approved",
      "running",
      "completed",
      "failed",
      "timed_out",
      "cancelled",
      "review_required",
      "review_blocked"
    ],
    "identityFields": [
      "organizationId",
      "workspaceId",
      "projectId",
      "taskId",
      "requestId",
      "approvalId",
      "jobId",
      "artifactId",
      "reviewId",
      "receiptId",
      "continuationId"
    ],
    "evidenceChain": [
      "request",
      "plan",
      "approval",
      "execution",
      "environment",
      "inputRefs",
      "outputRefs",
      "reviewerChecks",
      "cost",
      "receipt",
      "continuation"
    ],
    "opaqueProvenance": {
      "fields": [
        "artifactId",
        "reviewId",
        "inputRefs",
        "outputRefs",
        "reviewerChecks",
        "continuationId",
        "continuation"
      ],
      "semantics": "caller_owned_opaque_values_are_persisted_and_returned_without_ledger_interpretation",
      "continuationIdentity": "caller_supplied_only_ledger_does_not_generate_or_resolve_identity",
      "workspaceAuthorization": "forbidden",
      "historicalReceiptTypes": [
        "artifact.manifest.v1",
        "review.result.v1"
      ],
      "newStructuredWrites": false
    },
    "writeProtocol": "append_first_with_idempotency",
    "correctionProtocol": "append_superseding_receipt",
    "forbiddenContent": [
      "apiKey",
      "adminToken",
      "rawSub2apiResponse",
      "rawProviderResponse",
      "rawCredential",
      "password",
      "token",
      "secret",
      "signedUrl",
      "presignedUrl",
      "objectKey",
      "kubeconfig"
    ]
  },
  "workspaceAccessTokenResetReceipt": {
    "type": "workspace.access_token_reset",
    "idempotencyIdentity": "runtime-credential-rotate:<workspaceId>:<request-idempotency-key>",
    "requiredRefs": [
      "runtimeId",
      "computeAllocationId",
      "storageId",
      "credentialVersion",
      "credentialSecretRef",
      "owner.userId"
    ],
    "forbiddenContent": [
      "password",
      "apiKey",
      "rawCredential",
      "rawProviderResponse"
    ]
  },
  "workspaceGatewayKeyRotationReceipt": {
    "type": "workspace.gateway_key_rotated.v1",
    "requiredRefs": ["operationId", "workspaceId", "oldKeyId", "newKeyId", "secretFingerprint"],
    "forbiddenContent": ["apiKey", "rawCredential", "sessionCredential", "rawSub2apiResponse"]
  },
  "gatewayWalletAdjustmentReceipt": {
    "type": "gateway.wallet_adjustment.v1",
    "balanceAuthority": "sub2api",
    "commonRequiredRefs": ["operationId", "kind", "amountUsdMicros", "balanceHistoryRef", "actor"],
    "businessRefundAdditionalRequiredRefs": ["relatedOperationId"],
    "forbiddenContent": ["redeemCode", "adminToken", "rawSub2apiResponse"]
  },
  "monthlyBillingReceiptV1": {
    "status": "superseded_internal_compatibility",
    "types": [
      "billing.resource_purchased.v1",
      "billing.resource_renewed.v1",
      "billing.resource_expired.v1",
      "billing.resource_refunded.v1",
      "billing.charge_review_required.v1"
    ],
    "requiredCostFields": [
      "pricingVersion",
      "monthlyPriceCnyCents",
      "chargeUsdMicros",
      "sub2apiUserId",
      "sub2apiRedeemCode",
      "periodStart",
      "paidThrough",
      "resourceType",
      "resourceId"
    ],
    "costFieldTypes": {
      "pricingVersion": "non_empty_opaque_string",
      "monthlyPriceCnyCents": "non_negative_integer",
      "chargeUsdMicros": "non_negative_integer",
      "sub2apiUserId": "positive_integer",
      "sub2apiRedeemCode": "non_empty_opaque_string",
      "periodStart": "RFC3339_string",
      "paidThrough": "RFC3339_string",
      "resourceType": "non_empty_opaque_string",
      "resourceId": "non_empty_opaque_string"
    },
    "existingReceiptsReadable": true,
    "newWritesAllowed": false,
    "writeProtocol": "forbidden",
    "correctionProtocol": "historical_receipts_are_immutable",
    "forbiddenContentRule": "reject recursively by case-insensitive exact field name in maps, slices, and typed JSON containers; token-count fields such as inputTokens remain allowed",
    "forbiddenContent": [
      "apiKey",
      "adminToken",
      "rawSub2apiResponse",
      "rawProviderResponse",
      "password",
      "token"
    ]
  },
  "billingReconciliationReceiptV1": {
    "type": "billing.reconciliation.v1",
    "requiredCostFields": [
      "pricingVersion",
      "monthlyPriceCnyCents",
      "chargeUsdMicros",
      "sub2apiUserId",
      "sub2apiRedeemCode",
      "periodStart",
      "paidThrough",
      "resourceType",
      "resourceId"
    ],
    "writeProtocol": "append_first_with_idempotency"
  },
  "workspaceLaunchReceiptV1": {
    "state": "current",
    "authority": "unique_current_workspace_launch_receipt_union",
    "status": "completed",
    "surface": "control_plane",
    "requestId": "launchOperationId",
    "recordIdempotencyKey": "<launchOperationId>:purchase-receipt",
    "cardinality": {
      "perLaunchOperation": "exactly_one",
      "allowedTypes": ["billing.workspace_purchased.v1", "workspace.created"],
      "mixedOrDuplicate": "reject"
    },
    "owner": {
      "requiredFields": ["accountId", "workspaceId", "ownerUserId"],
      "allowedFields": ["accountId", "workspaceId", "ownerUserId"],
      "extraFields": "reject"
    },
    "canonicalFulfillmentIdentity": {
      "requiredFields": [
        "operationId",
        "resourceType",
        "resourceId",
        "computeAllocationId",
        "storageId",
        "attachmentId",
        "runtimeId",
        "workspaceApiKeyId",
        "workspaceKeyFingerprint",
        "runtimeServiceName",
        "gatewaySecretRef"
      ],
      "allowedFields": [
        "operationId",
        "resourceType",
        "resourceId",
        "computeAllocationId",
        "storageId",
        "attachmentId",
        "runtimeId",
        "workspaceApiKeyId",
        "workspaceKeyFingerprint",
        "runtimeServiceName",
        "gatewaySecretRef"
      ],
      "extraFields": "reject",
      "constraints": {
        "operationId": "equals_requestId",
        "resourceType": "workspace",
        "resourceId": "equals_workspaceId"
      },
      "providerSpecificFields": false
    },
    "variants": {
      "charged": {
        "type": "billing.workspace_purchased.v1",
        "cost": "required_exact_workspace_monthly_billing_cost",
        "costSchemaContract": "opl-cloud-evidence-ledger-contract.json#workspaceMonthlyBillingReceiptV1",
        "debit": "exact_sub2api_user_redeem_code_and_total_usd_micros"
      },
      "zeroCost": {
        "type": "workspace.created",
        "cost": "must_be_empty",
        "financialFields": "forbidden"
      }
    },
    "retry": "receipt_only_after_activation_without_repeating_key_debit_fabric_or_activation"
  },
  "workspaceMonthlyBillingReceiptV1": {
    "types": [
      "billing.workspace_purchased.v1",
      "billing.workspace_renewed.v1",
      "billing.workspace_expired.v1",
      "billing.workspace_refunded.v1"
    ],
    "statuses": ["completed"],
    "requiredCostFields": [
      "priceVersion",
      "currency",
      "billingUnit",
      "totalUsdMicros",
      "periodStart",
      "paidThrough",
      "resourceType",
      "resourceId",
      "components"
    ],
    "purchasedAdditionalCostFields": [
      "sub2apiUserId",
      "sub2apiRedeemCode",
      "postChargeBalanceUsdMicros"
    ],
    "renewedAdditionalCostFields": [
      "sub2apiUserId",
      "sub2apiRedeemCode",
      "postChargeBalanceUsdMicros"
    ],
    "refundedAdditionalCostFields": [
      "sub2apiUserId",
      "sub2apiRedeemCode",
      "sub2apiRefundCode",
      "refundUsdMicros"
    ],
    "exactComponents": {
      "compute": ["resourceType", "resourceId", "chargeUsdMicros"],
      "storage": ["resourceType", "resourceId", "sizeGb", "chargeUsdMicros"]
    },
    "refundedTerminalIdentity": {
      "requestId": "independentRefundOperationId",
      "recordIdempotencyKey": "<independentRefundOperationId>:refund-receipt",
      "workspaceId": "exact_refunded_workspace_id",
      "supersedesReceiptId": "exact_purchaseReceiptId",
      "cost": "exact_sub2api_user_debit_code_refund_code_total_and_refund_amount",
      "execution": "exact_purchase_receipt_and_refund_confirmation_from_the_same_independent_financial_operation",
      "retry": "receipt_only_without_repeating_sub2api_refund",
      "cardinality": "exactly_one_terminal_refund_receipt_for_the_independent_refund_operation",
      "workspaceDeleteCoupling": false
    },
    "customerProjectionForbiddenFields": [
      "computeReadback",
      "storageReadback",
      "workspaceKeyFingerprint",
      "runtimeServiceName",
      "secretRef"
    ],
    "rules": [
      "currency is USD and billingUnit is calendar_month",
      "resourceType is workspace",
      "cost.resourceId equals receipt workspaceId",
      "all money and size fields are integers with positive component amounts",
      "totalUsdMicros equals compute plus storage with int64 overflow rejection",
      "paidThrough is strictly after periodStart",
      "expired receipts contain no synthetic Sub2API charge identity",
      "expired receipts contain providerAction=none_expire_by_provider and describe no Fabric or Tencent mutation",
      "refunded receipts require the original debit identity, a stable refund identity, and refundUsdMicros equal to totalUsdMicros"
    ],
    "writeProtocol": "append_first_with_idempotency",
    "forbiddenContentRule": "same recursive case-insensitive exact-key rejection as general receipts"
  },
  "workspaceDeletionReceiptV1": {
    "type": "workspace.deleted.v1",
    "status": "completed",
    "surface": "control_plane",
    "requestId": "workspaceDeleteOperationId",
    "recordIdempotencyKey": "<workspaceDeleteOperationId>:deletion-receipt",
    "owner": {
      "requiredFields": ["accountId", "workspaceId", "ownerUserId"],
      "allowedFields": ["accountId", "workspaceId", "ownerUserId"],
      "extraFields": "reject"
    },
    "inputRefs": {
      "requiredFields": ["launchReceiptId"],
      "allowedFields": ["launchReceiptId"],
      "extraFields": "reject"
    },
    "execution": {
      "requiredFields": [
        "operationId",
        "resourceType",
        "resourceId",
        "computeAllocationId",
        "storageId",
        "attachmentId",
        "runtimeId",
        "workspaceApiKeyId",
        "workspaceKeyFingerprint",
        "runtimeServiceName",
        "gatewaySecretRef"
      ],
      "allowedFields": [
        "operationId",
        "resourceType",
        "resourceId",
        "computeAllocationId",
        "storageId",
        "attachmentId",
        "runtimeId",
        "workspaceApiKeyId",
        "workspaceKeyFingerprint",
        "runtimeServiceName",
        "gatewaySecretRef"
      ],
      "extraFields": "reject",
      "constraints": {
        "operationId": "equals_requestId",
        "resourceType": "workspace",
        "resourceId": "equals_workspaceId"
      },
      "identity": "exact_provider_neutral_resource_identity_from_the_same_delete_operation"
    },
    "outputRefs": {
      "requiredFields": [
        "runtimeStatus",
        "gatewaySecretStatus",
        "attachmentStatus",
        "storageStatus",
        "computeStatus",
        "workspaceKeyStatus",
        "workspaceStatus"
      ],
      "allowedFields": [
        "runtimeStatus",
        "gatewaySecretStatus",
        "attachmentStatus",
        "storageStatus",
        "computeStatus",
        "workspaceKeyStatus",
        "workspaceStatus"
      ],
      "extraFields": "reject",
      "requiredValue": "absent"
    },
    "forbiddenFieldPrefixesCaseInsensitive": ["cost", "refund", "debit", "wallet", "supersedes"],
    "forbiddenFieldRule": "reject_recursively_when_field_name_equals_or_starts_with_a_forbidden_prefix",
    "failureRetry": "receipt_only_without_repeating_resource_key_or_workspace_deletion",
    "cardinality": "exactly_one_terminal_deletion_receipt_for_the_workspace_delete_operation"
  },
  "reconciliationReportV1": {
    "recordApi": "POST /ledger/reconciliation",
    "idempotencyKey": "required_non_blank",
    "requiredReportFields": ["id", "status", "counts", "exceptions"],
    "id": "non_empty_string",
    "statuses": ["ok", "mismatch"],
    "counts": {
      "requiredFields": ["billingOperations", "matched", "exceptions"],
      "allFields": "non_negative_integer"
    },
    "exceptions": {
      "type": "array",
      "requiredFields": ["resourceType", "resourceId", "code"],
      "resourceTypes": ["compute", "storage", "workspace"],
      "resourceId": "non_empty_opaque_string",
      "codes": [
        "billing_operation_invalid",
        "sub2api_balance_history_unavailable",
        "sub2api_charge_missing",
        "sub2api_charge_mismatch",
        "fabric_operations_unavailable",
        "fabric_operation_missing",
        "fabric_operation_mismatch",
        "ledger_receipts_unavailable",
        "ledger_receipt_missing",
        "ledger_receipt_mismatch"
      ]
    },
    "workspaceRenewalAuthority": {
      "customerOperationCardinality": 1,
      "balanceFact": "one_combined_sub2api_charge",
      "providerFacts": ["compute_renewal", "storage_renewal"],
      "receiptType": "billing.workspace_renewed.v1"
    },
    "consistencyRules": [
      "counts.exceptions equals exceptions length",
      "counts.billingOperations equals counts.matched plus unique exception resource count",
      "ok has zero exceptions and does not block new Workspaces",
      "mismatch has at least one exception and blocks new Workspaces"
    ],
    "result": {
      "identity": "id and status equal the submitted report",
      "report": "structurally_equal_to_submitted_report",
      "blockNewWorkspaces": "status_equals_mismatch",
      "reason": "operator_reconciliation"
    },
    "validationOrder": "validate before hash, idempotency lookup, or persistence",
    "replayRule": "validate persisted report and result guard before return",
    "forbiddenContentRule": "same recursive case-insensitive exact-field rule as receipts"
  },
  "workspaceCreateReceipt": {
    "state": "current_zero_cost_projection",
    "type": "workspace.created",
    "launchReceiptContract": "opl-cloud-evidence-ledger-contract.json#workspaceLaunchReceiptV1",
    "variant": "zeroCost",
    "newWrites": "must_match_workspaceLaunchReceiptV1",
    "historicalReadOnlyMatcher": {
      "resourceRefs": ["serverId", "dockerId", "storageId", "storageMountPath", "runtimeStatus", "credentialStatus"],
      "existingReceiptsReadable": true,
      "newWritesAllowed": false
    }
  },
  "nonGoals": [
    "workspace backup recovery sync or transfer evidence",
    "artifact byte storage ownership",
    "domain reviewer implementation logic",
    "agent package execution",
    "connector credential storage"
  ]
}
