      "action": "ensure_runtime"
    }
  ],
  "runtimeRepair": {
    "route": "POST /fabric/workspace-runtimes/{workspaceId}/repair",
    "action": "repair_workspace_runtime",
    "adapterPolicy": "explicit_opt_in_or_fail_closed",
    "requestFields": ["workspaceId", "computeId", "volumeId", "attachmentId", "attachmentOperationId", "runtimeOperationId", "previousRuntimeOperationId", "imageId", "gatewaySecretRef"],
    "idempotencyHeader": "Idempotency-Key",
    "preMutationEvidence": "persisted_succeeded_original_runtime_operation_matching_workspaceId_and_previousRuntimeOperationId",
    "preserved": ["computeId", "volumeId", "attachmentId", "attachmentOperationId", "gatewaySecretRef", "runtimeId", "serviceName"],
    "replaced": ["runtimeOperationId", "imageId", "runtimeUrl"],
    "providerMutation": "replace_runtime_only_without_destroying_gateway_secret_compute_storage_or_attachment",
    "operationBindingFields": ["previousRuntimeOperationId", "replacementRuntimeOperationId", "imageId"],
    "exactReplay": "same_idempotency_key_and_request_hash_returns_the_persisted_replacement_runtime",
    "canonicalReadback": "successful_repair_operation_supersedes_the_failed_original_runtime_candidate_for_workspace_status"
  },
  "readback": {
    "identityField": "fabricOperationId",
    "matchFields": [
      "schemaVersion",
      "launchOperationId",
      "accountId",
      "workspaceId",
      "stage",
      "action",
      "fabricOperationId",
      "idempotencyKey",
      "requestHash",
      "expectedResourceBinding"
    ],
    "resultBinding": "exact_persisted_binding",
    "typedStateReasonMatrix": {
      "ready": ["none"],
      "pending": ["provider_provisioning"],
      "absent": ["no_stage_record", "started_no_resource", "failed_no_resource"],
      "unknown": ["failed_no_resource_unproven", "resource_absence_status_conflict"]
    },
    "adapterReplayPolicy": {
      "order": [
        "owner_authoritative_read",
        "durable_same_operation_child_replay_cas",
        "second_owner_authoritative_read",
        "exact_original_idempotency_transport_replay_only_if_still_absent"
      ],
      "ready": "converge_without_provider_mutation",
      "pending": "typed_continuation_read_only",
      "absent": "adapter_opt_in_requires_exact_resource_identity_and_idempotency_contract",
      "unknownOrConflictOrError": "fail_closed_without_provider_mutation",
      "attachment": "no_independent_provider_mutation_and_converges_from_exact_compute_and_storage_identity",
      "childTransportLease": "fabric_local_replay_epoch_bound_to_the_parent_operation_exact_child_identity_and_original_idempotency_key; it_serializes_transport_dispatch_and_is_not_control_plane_authorization_or_a_business_attempt_budget"
    },
    "forbiddenInference": [
      "idempotency_suffix",
      "unscoped_operation_list",
      "provider_tag",
      "provider_resource_name"
    ]
  },
  "notOwned": [
    "launch_business_stage_decision",
    "provider_profile_configuration_or_instance_selection",
    "package_size_or_image_choice",
    "gateway_credential_value",
    "control_plane_operator_recovery_authorization_or_mutation_or_read_budget",
    "customer_balance_or_settlement",
    "ledger_receipt_or_evidence_truth"
  ]
}
