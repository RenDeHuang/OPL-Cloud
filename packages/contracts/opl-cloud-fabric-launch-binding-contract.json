      "launchOperationId",
      "accountId",
      "workspaceId",
      "stage",
      "action",
      "fabricOperationId",
      "idempotencyKey",
      "requestHash",
      "expectedResourceBinding"
    ],
    "writeProtocol": "control_plane_submits_complete_binding_and_fabric_persists_it_before_provider_write",
    "readProtocol": "lookup_by_explicit_fabricOperationId_and_require_exact_binding_match",
    "requestHash": "hash_of_the_stage_specific_provider_neutral_request",
    "expectedResourceBinding": "exact_provider_neutral_binding_ref_when_the_caller_has_an_expected_resource",
    "stageSemantics": "control_plane_durable_cursor",
    "actionSemantics": "fabric_mutation_command",
    "immutability": "all_fields_are_immutable_for_one_fabricOperationId"
  },
  "stageRequestHash": {
    "algorithm": "sha256",
    "digestEncoding": "lowercase_hex",
    "payloadFields": [
