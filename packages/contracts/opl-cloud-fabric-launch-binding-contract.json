{
  "schemaVersion": 3,
  "owner": "services/fabric",
  "purpose": "Bind one Control Plane Workspace launch stage to one explicit Fabric operation and its expected provider-neutral resource binding.",
  "state": "current",
  "machineBoundary": "The typed Control Plane to Fabric preflight, stage read, and stage ensure seam for immutable launch and Fabric operation identity.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Remove only when no Workspace launch caller submits or reads Fabric stage bindings."
  },
  "workspaceLaunchApi": {
    "preflightRoute": "POST /fabric/workspace-launches/preflight",
    "stageReadRoute": "POST /fabric/workspace-launches/stages/read",
    "stageEnsureRoute": "POST /fabric/workspace-launches/stages/ensure",
    "bindingType": "WorkspaceLaunchStageBinding",
    "ensureIdempotencyHeader": "Idempotency-Key equals binding.idempotencyKey"
  },
  "preflight": {
    "mode": "read_only_admission",
    "configuredProfileSelectionOwner": "instance_repository",
    "implementationScope": "opl-instance-medopl is one concrete Tencent profile instance, not the unique owner of the public Cloud contract.",
    "admittedBindingReadbackOwner": "services/fabric",
    "requestFields": [
      "schemaVersion",
      "launchOperationId",
      "accountId",
      "workspaceId",
      "packageId",
      "sizeGb",
      "workspaceImageDigest",
      "requestHash"
    ],
    "forbiddenRequestFields": [
      "resources"
    ],
    "responseIdentityFields": [
      "schemaVersion",
      "launchOperationId",
      "requestHash",
      "providerProfileRef",
      "providerBindingRef",
      "specDigest"
    ],
    "responseForbiddenFields": [
      "canonicalProviderPlan",
      "providerPlan",
      "cpu",
      "memoryGb",
      "diskGb",
      "instanceType",
      "nodePoolId",
      "zone",
      "diskType",
      "chargeType",
      "renewFlag"
    ]
  },
  "stageInput": {
    "fields": [
      "binding",
      "providerProfileRef",
      "providerBindingRef",
      "specDigest",
      "packageId",
      "sizeGb",
      "workspaceImageDigest",
      "resources",
      "gatewayCredential"
    ],
    "forbiddenFields": [
      "resumeAuthorizationDigest",
      "mutationBudget",
      "canonicalProviderPlan",
      "providerPlan",
      "cpu",
      "memoryGb",
      "diskGb",
      "instanceType",
      "nodePoolId",
      "zone",
      "diskType",
      "chargeType",
      "renewFlag"
    ],
    "gatewayCredential": "optional_secret_stage_transport_only_never_hashed_or_persisted"
  },
  "providerBinding": {
    "owner": "services/fabric",
    "identityField": "providerBindingRef",
    "digestField": "specDigest",
    "canonicalPlanField": "canonicalProviderPlan",
    "persistedFields": [
      "providerBindingRef",
      "providerProfileRef",
      "packageId",
      "canonicalProviderPlan",
      "specDigest"
    ],
    "responseFields": [
      "providerBindingRef",
      "specDigest"
    ],
    "canonicalProviderPlan": "provider-owned structured JSON retained by Fabric and never submitted by Control Plane or Console",
    "digest": {
      "algorithm": "sha256",
      "encoding": "lowercase_hex",
      "input": "canonicalProviderPlanEnvelope",
      "canonicalJson": {
        "characterEncoding": "utf-8",
        "whitespace": "none",
        "objectKeys": "lexicographic_utf8_order",
        "arrayOrder": "preserve_input_order"
      }
    },
    "bindingRules": [
      "providerBindingRef identifies exactly one immutable Fabric-persisted binding",
      "specDigest must match the persisted canonicalProviderPlan digest",
      "replay and readback reuse the original providerBindingRef and specDigest",
      "a current Provider Profile change cannot replace an existing binding"
    ],
    "goldenVectors": [
      {
        "providerProfileRef": "fixture-provider:profile-v1",
        "packageId": "basic",
        "canonicalProviderPlanEnvelope": {
          "packageId": "basic",
          "providerProfileRef": "fixture-provider:profile-v1",
          "schemaVersion": 1,
          "spec": {
            "compute": {
              "cpu": 2,
              "memoryGb": 4
            },
            "storage": {
              "sizeGb": 10
            }
          }
        },
        "canonicalJson": "{\"packageId\":\"basic\",\"providerProfileRef\":\"fixture-provider:profile-v1\",\"schemaVersion\":1,\"spec\":{\"compute\":{\"cpu\":2,\"memoryGb\":4},\"storage\":{\"sizeGb\":10}}}",
        "specDigest": "a186e4c78fa0197fd827e4810b1db83f0fee8f703cf378a9ff776df474059257"
      }
    ]
  },
