{
  "schemaVersion": 1,
  "owner": "services/fabric",
  "purpose": "Bind a Control Plane Workspace launch stage to one durable Fabric operation and its expected resource readback.",
  "state": "current",
  "machineBoundary": "Provider-neutral Control Plane to Fabric operation identity, request hash, resource binding, and readback proof for the current Workspace launch caller.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Remove only when no Workspace launch caller consumes Fabric stage operations or their authoritative readback."
  },
  "launchBinding": {
    "controlPlaneIdentityFields": [
      "launchOperationId",
      "launchRequestHash",
      "accountId",
      "workspaceId"
    ],
    "fabricStageIdentityFields": [
      "stage",
      "fabricRecordId",
      "fabricOperationId",
      "idempotencyKey",
      "requestHash"
    ],
    "expectedResourceBindingFields": [
      "action",
      "resourceKind",
      "resourceId",
      "accountId",
      "workspaceId"
    ],
    "requestHash": "sha256_of_the_action_specific_request_body_must_equal_the_persisted_fabric_operation_requestHash",
    "matchCardinality": "exactly_one_fabric_operation"
  },
  "stageOperations": [
    {
      "stage": "compute",
      "action": "create_compute_allocation",
      "resourceKind": "compute_allocation",
      "resourceIdField": "computeAllocationId",
      "idempotencyIdentity": "<launchOperationId>:compute",
      "readback": "persisted_operation_and_provider_resource_truth"
    },
    {
      "stage": "storage",
      "action": "create_storage_volume",
      "resourceKind": "storage_volume",
      "resourceIdField": "storageId",
      "idempotencyIdentity": "<launchOperationId>:storage",
      "readback": "persisted_operation_and_provider_resource_truth"
    },
    {
      "stage": "attachment",
      "action": "create_storage_attachment",
      "resourceKind": "storage_attachment",
      "resourceIdField": "attachmentId",
      "idempotencyIdentity": "<attachmentOperationId>",
      "readback": "provider_readback_proof_then_optional_operation_cas"
    },
    {
      "stage": "secret",
      "action": "upsert_gateway_secret",
      "resourceKind": "gateway_secret",
      "resourceIdField": "gatewaySecretRef",
      "idempotencyIdentity": "<workspaceOperationId>:secret:gateway-secret",
      "readback": "provider_readback_proof_then_optional_operation_cas"
    },
    {
      "stage": "runtime",
      "action": "create_workspace_runtime",
      "resourceKind": "workspace_runtime",
      "resourceIdField": "workspaceId",
      "idempotencyIdentity": "<workspaceOperationId>:runtime",
      "readback": "provider_readback_proof_then_optional_operation_cas"
    }
  ],
  "stageReadbackApi": {
    "proofRoute": "POST /fabric/workspace-launch-stage-readback/proof",
    "convergeRoute": "POST /fabric/workspace-launch-stage-readback/converge",
    "supportedStages": [
      "attachment",
      "secret",
      "runtime"
    ],
    "requestFields": [
      "stage",
      "fabricRecordId",
      "fabricOperationId",
      "accountId",
      "workspaceId",
      "idempotencyKey",
      "requestHash",
      "computeId",
      "storageId",
      "attachmentId",
      "attachmentOperationId",
      "runtimeId",
      "runtimeOperationId",
      "imageId",
      "gatewaySecretRef",
      "gatewaySecretFingerprint",
      "workspaceApiKeyId",
      "expectedBindingDigest"
    ],
    "proofFields": [
      "schemaVersion",
      "eligible",
      "reason",
      "stage",
      "priorStatus",
      "bindingDigest",
      "operation",
      "sub2apiMutationCount",
      "tencentMutationCount",
      "kubernetesMutationCount",
      "fabricOperationMutationCount"
    ],
    "proofMutationCounts": {
      "sub2api": 0,
      "provider": 0,
      "kubernetes": 0,
      "fabricOperation": 0
    },
    "convergeFabricOperationMutationMaximum": 1,
    "expectedBindingDigest": "required_to_converge_and_required_when_the_persisted_operation_is_already_succeeded"
  },
  "notOwned": [
    "launch_business_stage_decision",
    "customer_balance_or_settlement",
    "recovery_authorization",
    "ledger_receipt_or_evidence_truth"
  ]
}
