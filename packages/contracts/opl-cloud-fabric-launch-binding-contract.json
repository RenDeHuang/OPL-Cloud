        "runtimeUsername",
        "runtimeUrl",
        "runtimeCredentialStatus",
        "runtimeCredentialVersion",
        "runtimeCredentialSecretRef",
        "runtimeBindingRef"
      ],
      "omitEmptyResourceStrings": true
