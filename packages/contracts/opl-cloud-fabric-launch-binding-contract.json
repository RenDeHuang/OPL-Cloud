{
  "schemaVersion": 1,
  "owner": "services/fabric",
  "purpose": "Bind one Control Plane Workspace launch stage to one explicit Fabric operation and its expected provider-neutral resource binding.",
  "state": "current",
  "machineBoundary": "The typed Control Plane to Fabric preflight, stage read, and stage ensure seam for immutable launch and Fabric operation identity.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Remove only when no Workspace launch caller submits or reads Fabric stage bindings."
  },
  "workspaceLaunchApi": {
    "preflightRoute": "POST /fabric/workspace-launches/preflight",
    "stageReadRoute": "POST /fabric/workspace-launches/stages/read",
    "stageEnsureRoute": "POST /fabric/workspace-launches/stages/ensure",
    "bindingType": "WorkspaceLaunchStageBinding",
    "ensureIdempotencyHeader": "Idempotency-Key equals binding.idempotencyKey"
  },
  "preflight": {
    "mode": "read_only_admission",
    "configuredProfileSelectionOwner": "instance_repository",
    "implementationScope": "opl-instance-medopl is one concrete Tencent profile instance, not the unique owner of the public Cloud contract.",
    "admittedBindingReadbackOwner": "services/fabric",
    "responseIdentityFields": [
      "schemaVersion",
      "launchOperationId",
      "requestHash",
      "providerProfileRef",
      "bindingRef"
    ]
  },
  "launchBinding": {
    "schemaVersion": 1,
    "fields": [
      "schemaVersion",
      "launchOperationId",
      "accountId",
      "workspaceId",
      "stage",
      "action",
      "fabricOperationId",
      "idempotencyKey",
      "requestHash",
      "expectedResourceBinding"
    ],
    "writeProtocol": "control_plane_submits_complete_binding_and_fabric_persists_it_before_provider_write",
    "readProtocol": "lookup_by_explicit_fabricOperationId_and_require_exact_binding_match",
    "requestHash": "hash_of_the_stage_specific_provider_neutral_request",
    "expectedResourceBinding": "exact_provider_neutral_binding_ref_when_the_caller_has_an_expected_resource",
    "stageSemantics": "control_plane_durable_cursor",
    "actionSemantics": "fabric_mutation_command",
    "immutability": "all_fields_are_immutable_for_one_fabricOperationId"
  },
  "stageOperations": [
    {
      "stage": "ensure_compute_allocation",
      "action": "ensure_compute_allocation"
    },
    {
      "stage": "storage",
      "action": "ensure_storage"
    },
    {
      "stage": "attachment",
      "action": "ensure_attachment"
    },
    {
      "stage": "secret",
      "action": "ensure_gateway_secret"
    },
    {
      "stage": "runtime",
      "action": "ensure_runtime"
    }
  ],
  "readback": {
    "identityField": "fabricOperationId",
    "matchFields": [
      "schemaVersion",
      "launchOperationId",
      "accountId",
      "workspaceId",
      "stage",
      "action",
      "fabricOperationId",
      "idempotencyKey",
      "requestHash",
      "expectedResourceBinding"
    ],
    "resultBinding": "exact_persisted_binding",
    "forbiddenInference": [
      "idempotency_suffix",
      "unscoped_operation_list",
      "provider_tag",
      "provider_resource_name"
    ]
  },
  "notOwned": [
    "launch_business_stage_decision",
    "provider_profile_configuration_or_instance_selection",
    "package_size_or_image_choice",
    "gateway_credential_value",
    "recovery_authorization_or_mutation_budget",
    "customer_balance_or_settlement",
    "ledger_receipt_or_evidence_truth"
  ]
}
