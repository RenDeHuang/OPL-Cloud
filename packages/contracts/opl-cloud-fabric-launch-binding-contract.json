        "gatewaySecretRef",
        "gatewaySecretVersion",
        "gatewaySecretFingerprint",
        "secretBindingRef",
        "runtimeId",
        "runtimeServiceName",
        "runtimeUsername",
        "runtimeUrl",
        "runtimeCredentialStatus",
        "runtimeCredentialVersion",
        "runtimeCredentialSecretRef",
        "runtimeBindingRef"
      ],
      "omitEmptyResourceStrings": true
    },
    "bindingProjection": "action_only",
    "excludedBindingFields": [
      "schemaVersion",
      "launchOperationId",
      "accountId",
      "workspaceId",
      "stage",
      "fabricOperationId",
      "idempotencyKey",
      "requestHash",
      "expectedResourceBinding"
    ],
    "excludedStageInputFields": [
      "providerProfileRef",
      "providerBindingRef",
      "specDigest",
      "gatewayCredential"
    ],
    "consumerModules": [
      "services/control-plane",
      "services/fabric"
    ],
    "testFixturePolicy": "read_this_goldenVectors_array_without_a_copied_caller_hash_helper",
    "outsideHashValidation": {
      "bindingIdentity": "exact_immutable_launch_stage_binding",
      "providerProfileRef": "exact_admitted_preflight_profile",
      "providerBindingRef": "exact_immutable_provider_binding",
      "specDigest": "exact_digest_of_persisted_canonical_provider_plan"
