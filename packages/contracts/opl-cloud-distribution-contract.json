{
  "schemaVersion": 1,
  "owner": "OPL Cloud",
  "purpose": "Portable product distribution and instance handoff boundary.",
  "state": "current",
  "machineBoundary": "Cloud publishes portable immutable product artifacts without deploying an instance; concrete provider selection and deployment belong to an instance owner.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Replace only with a newer current contract for the same distribution and instance-handoff boundary."
  },
  "productRepository": "gaofeng21cn/one-person-lab-cloud",
  "distribution": {
    "workflow": ".github/workflows/release-opl-cloud-image.yml",
    "registry": "ghcr.io/gaofeng21cn/one-person-lab-cloud",
    "releaseTagFormat": "v0.x.y",
    "mutableTagsForbidden": [
      "latest",
      "stable"
    ],
    "platforms": [
      "linux/amd64",
      "linux/arm64"
    ],
    "releaseAssets": [
      "compose.yaml",
      "compose.local-workspace.yaml",
      "opl-cloud.env.example",
      "opl-cloud-release.json",
      "SHA256SUMS"
    ],
    "assetIntegrity": {
      "checksumManifest": "SHA256SUMS",
      "provenance": "github_oidc_custom_attestation",
      "predicateType": "https://github.com/gaofeng21cn/one-person-lab-cloud/attestations/opl-cloud-release/v1",
      "signerWorkflow": ".github/workflows/release-opl-cloud-image.yml"
    },
    "immutableIdentity": [
      "releaseTag",
      "productSha",
      "imageDigest",
      "releaseAssetSha256",
      "releaseAssetProvenance"
    ]
  },
  "portableInstallation": {
    "entrypoint": "compose.yaml",
    "documentation": "docs/installation.md",
    "runtimeImagePolicy": "all_compose_images_require_registry_tag_and_sha256_digest",
    "processes": [
      "control-plane",
      "fabric",
      "ledger"
    ],
    "persistence": "postgresql",
    "providerSelection": "instance_or_installer_owned",
    "workspaceProviderRequired": true,
    "composeScope": "cloud_control_services_only",
    "composeDoesNotProve": [
      "workspace_create",
      "workspace_readback",
      "workspace_access",
      "workspace_delete"
    ]
  },
  "instanceHandoff": {
    "repository": "gaofeng21cn/opl-instance-medopl",
    "inputs": [
      "productSha",
      "imageDigest"
    ],
    "cloudRepositoryMustNotOwn": [
      "instance_domains",
      "production_environment",
      "production_secrets",
      "deployment_dispatch",
      "instance_canary",
      "instance_rollback",
      "production_receipts"
    ]
  },
  "evidenceOwners": {
    "currentCapability": "docs/status.md",
    "activeGapsAndPriority": "docs/roadmap.md"
  }
}
