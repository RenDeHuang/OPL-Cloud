{
  "schemaVersion": 1,
  "owner": "OPL Console",
  "purpose": "Frozen React presentation contract for the customer and operator Console surfaces.",
  "state": "current",
  "machineBoundary": "Console framework, component foundation, primary pages, slides, source-state presentation, secret handling, and browser API boundary.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Replace only with a newer approved Console UI contract and matching display, implementation, and runtime evidence."
  },
  "surface": "standalone_console",
  "framework": "react",
  "componentFoundation": "@openai/apps-sdk-ui",
  "visualDirection": {
    "id": "quiet-ledger",
    "status": "frozen",
    "reference": {
      "path": "output/imagegen/opl-console-option-1-quiet-ledger-1440x1024.png",
      "sha256": "9b75ba8b01cda552fcb7d44bc774797f22697f5fd4a0c067e885bc4895b738b5",
      "mutationPolicy": "immutable_no_regenerate_edit_or_overwrite"
    },
    "layout": "240px_light_rail_white_canvas_open_metrics_workspace_primary",
    "palette": "neutral_surfaces_deep_green_actions_semantic_status_colors",
    "forbiddenPresentation": [
      "visible_internal_slide_ids",
      "navy_overview_hero",
      "gradient_decoration",
      "fabric_runtime_claim_from_control_plane_workspace_count",
      "synthetic_api_usage_time_series"
    ]
  },
  "usageRecordPresentation": {
    "desktopColumns": ["model_endpoint", "tokens", "actual_cost", "latency", "time", "request_id"],
    "tokenFields": ["inputTokens", "outputTokens", "cacheReadTokens", "cacheCreationTokens"],
    "latencyFields": ["firstTokenMs", "durationMs"],
    "missingLatency": "dash_never_zero_or_derived"
  },
  "operatorAccountPresentation": {
    "desktopColumns": ["user", "account_mapping", "balance", "api_cost", "resources", "status", "actions"],
    "nestedSourceDiagnostics": "account_detail_only",
    "browserSearchOrSort": false,
    "mobile": "compact_cards_same_fact_order"
  },
  "workspaceLaunchVisual": {
    "id": "split-decision",
    "status": "frozen",
    "reference": {
      "path": "output/imagegen/opl-workspace-launch-option-1-split-decision-1440x1024.png",
      "sha256": "897f657539d2ccd8e10df365e5108094bee3a68ffd1c349190f692501657b4b6",
      "mutationPolicy": "immutable_no_regenerate_edit_or_overwrite"
    },
    "states": ["configure", "confirm", "operation"],
    "layout": "left_decision_surface_with_320px_sticky_order_summary",
    "authoritativeReads": [
      "GET /api/pricing/catalog",
      "POST /api/pricing/preview",
      "GET /api/gateway/wallet",
      "POST /api/workspace-launches",
      "GET /api/workspace-launches/{operationId}"
    ],
    "fieldAudit": {
      "configure": [
        {
          "display": "package_identity_availability_and_shape",
          "api": "GET /api/pricing/catalog",
          "fields": ["packages[].id", "packages[].name", "packages[].available", "packages[].cpu", "packages[].memoryGb", "packages[].diskGb"]
        },
        {
          "display": "compute_storage_total_and_billing_cycle",
          "api": "POST /api/pricing/preview",
          "fields": ["compute.chargeUsdMicros", "storage.chargeUsdMicros", "totalChargeUsdMicros", "priceVersion", "currency", "billingUnit"]
        },
        {
          "display": "spendable_balance",
          "api": "GET /api/gateway/wallet",
          "fields": ["data.usdMicros", "data.currency", "available", "status"]
        },
        {
          "display": "workspace_name_and_renewal_intent",
          "api": "POST /api/workspace-launches",
          "fields": ["request.name", "request.packageId", "request.sizeGb", "request.autoRenew"]
        }
      ],
      "operation": [
        {
          "display": "authoritative_launch_readback",
          "api": "GET /api/workspace-launches/{operationId}",
          "fields": ["operationId", "status", "phase", "name", "packageId", "priceVersion", "currency", "totalChargeUsdMicros", "autoRenew", "createdAt", "updatedAt", "errorCode"]
        }
      ],
      "presentationOnly": [
        {
          "display": "configure_confirm_operation_steps",
          "source": "browser_navigation_state",
          "businessFact": false
        },
        {
          "display": "human_readable_phase_label",
          "source": "phase_code_label_mapping",
          "businessFact": false
        }
      ]
    },
    "submissionGuard": {
      "inputs": ["wallet.data.usdMicros", "preview.totalChargeUsdMicros"],
      "comparison": "strict_gt",
      "authority": "client_feedback_only_server_rechecks"
    },
    "forbiddenPresentation": [
      "inferred_per_phase_completion",
      "frontend_post_debit_balance",
      "visible_source_provenance_explanations",
      "unsupported_region_capacity_or_eta"
    ]
  },
  "displayContract": "docs/product/console-display-contract-v1.md",
  "sourceTruthContract": "packages/contracts/opl-cloud-console-source-truth-contract.json",
  "launchFreezeContract": "packages/contracts/opl-cloud-launch-freeze-contract.json",
  "browserApiBoundary": "control_plane_product_apis_only",
  "primaryPages": {
    "customer": ["overview", "workspaces", "api", "billing", "announcements"],
    "admin": ["operations_overview", "accounts", "billing_review", "resources", "system"]
  },
  "sourceStates": ["available", "empty", "unavailable"],
  "secretPolicy": {
    "default": "hidden",
    "reveal": "explicit_owner_action_only",
    "browserPersistence": "forbidden",
    "clearAfterMilliseconds": 60000,
    "clearOn": ["sensitive_route_leave", "account_change", "logout"]
  },
  "designAssistOnly": ["gpt-5.6-sol", "gpt-image-2", "computer-use"],
  "forbidden": [
    "vue_runtime",
    "vue_sfc",
    "vite_vue_plugin",
    "browser_business_truth",
    "runtime_gpt_dependency",
    "second_wallet",
    "second_gateway"
  ]
}
