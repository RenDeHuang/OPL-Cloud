{
  "schemaVersion": 40,
  "owner": "OPL Platform Architecture",
  "purpose": "Enforce the physical boundaries between Console UI, Control Plane, Fabric, Ledger, and external Sub2API while pointing launch and settlement facts to their focused owners.",
  "state": "current",
  "machineBoundary": "Module paths, persistence owners, cross-service transport, forbidden source and database coupling, cloud SDK placement, and focused launch contract routing.",
  "lifecycle": {
    "type": "long_term_contract",
    "removalCondition": "Replace only with a newer current service-boundary contract."
  },
  "physicalBoundaries": {
    "crossServiceTransport": "typed_public_http_contracts_only",
    "crossServiceSourceImports": "forbidden",
    "crossServiceDatabaseAccess": "forbidden",
    "consoleRuntimeImports": "forbidden_control_plane_product_api_only",
    "sourceGate": "tests/contracts/module-physical-boundaries.test.ts",
    "consoleNetworkOwner": "apps/console-ui/src/api",
    "consoleAllowedNetworkPrefix": "/api/",
    "cloudSdkOwner": "services/fabric",
    "cloudSdkImportPrefixes": [
      "github.com/tencentcloud/",
      "k8s.io/"
    ],
    "ciEntry": "npm test",
    "allowedSharedGoModules": [
      "opl-cloud/services/internal/postgresmigrate"
    ],
    "serviceGoModules": {
      "controlPlane": "opl-cloud/services/control-plane",
      "fabric": "opl-cloud/services/fabric",
      "ledger": "opl-cloud/services/ledger"
    }
  },
  "focusedOwners": {
    "settlement": "opl-cloud-billing-ledger-contract.json",
    "controlPlaneLaunchRecovery": "opl-cloud-control-plane-launch-contract.json",
    "fabricLaunchBinding": "opl-cloud-fabric-launch-binding-contract.json",
    "ledgerReceiptEvidence": "opl-cloud-evidence-ledger-contract.json"
  },
  "services": {
    "consoleUi": {
      "path": "apps/console-ui",
      "persistence": "none",
      "calls": {
        "controlPlane": "http"
      }
    },
    "controlPlane": {
      "path": "services/control-plane",
      "language": "go",
      "persistence": "postgresql",
      "owns": [
        "sessions",
        "announcements",
        "announcementReads",
        "accountMappings",
        "internalOneToOneIdentityCompatibilityRecords",
        "workspaces",
        "monthlyEntitlements",
        "billingOperations",
        "latestReconciliationGuard",
        "supportTicketMappings",
        "operationRequests"
      ],
      "calls": {
        "ledger": "http",
        "fabric": "http",
        "sub2api": "http"
      },
      "workspaceLaunchContract": "opl-cloud-control-plane-launch-contract.json",
      "walletMutationSerialization": {
        "deployment": "single_control_plane_replica",
        "scope": "process_local",
        "primitive": "lockResource(\"sub2api-wallet\", accountId)",
        "operations": [
          "operator_wallet_adjustment",
          "workspace.launch.v2_debit",
          "workspace.launch.v2_refund",
          "workspace_renewal_debit",
          "workspace_renewal_refund"
        ],
        "additionalLockService": false,
        "multiReplicaPolicy": "forbidden_until_approved_distributed_serialization"
      }
    },
    "fabric": {
      "path": "services/fabric",
      "language": "go",
      "persistence": "postgresql",
      "owns": [
        "resourceCatalog",
        "computeAllocations",
        "storageVolumes",
        "storageAttachments",
        "workspaceRuntimes",
        "jobs",
        "providerRequests"
      ],
      "workspaceLaunch": {
        "contract": "opl-cloud-fabric-launch-binding-contract.json",
        "routes": [
          "POST /fabric/workspace-launches/preflight",
          "POST /fabric/workspace-launches/stages/read",
          "POST /fabric/workspace-launches/stages/ensure"
        ]
      }
    },
    "ledger": {
      "path": "services/ledger",
      "language": "go",
      "persistence": "postgresql",
      "owns": [
        "evidenceReceipts",
        "artifactManifests",
        "reviewResults",
        "reviewPolicies",
        "continuations",
        "auditEvents",
        "idempotencyKeys",
        "reconciliationReports"
      ],
      "receiptEvidenceContract": "opl-cloud-evidence-ledger-contract.json",
      "writeProtocol": "append_first_with_idempotency",
      "readApis": [
        "receiptQuery",
        "paginatedTenantReceiptQuery",
        "reviewPolicyQuery",
        "reviewGateEvaluation"
      ]
    }
  },
  "externalServices": {
    "gateway": {
      "product": "Sub2API",
      "origin": "configured_sub2api_base_url",
      "owns": [
        "customerIdentities",
        "customerPasswords",
        "spendableBalances",
        "apiKeys",
        "routePolicies",
        "modelPolicies",
        "usageEvents"
      ]
    }
  },
  "browserBoundary": {
    "onlyCalls": "control_plane_product_apis",
    "forbidden": [
      "sub2api_management_direct",
      "sub2api_management_redirect",
      "sub2api_management_iframe",
      "html_scraping",
      "raw_admin_dto"
    ]
  },
  "customerMutationBoundary": {
    "payment": false,
    "topUp": false,
    "keyCreate": true,
    "keyRevoke": true
  }
}
